<!DOCTYPE html>
<html lang="ja">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Drowpal | 研究支援アプリ</title>
    <link rel="stylesheet" href="/style.css" />
  </head>
  <body>
    <main class="app-shell">
      <section class="main-panel">
        <section class="feature-panel" aria-label="主要機能">
          <div class="feature-view is-active" data-view="home">
            <div class="summary-grid">
              <div class="summary-card"><strong>キャラクター</strong><p><%= character?.name || '未設定' %></p></div>
              <div class="summary-card"><strong>振り返り</strong><p><%= reflectionCount %> 件</p></div>
              <div class="summary-card"><strong>イラスト</strong><p><%= illustrationCount %> 件</p></div>
            </div>
            <div class="panel-block"><h3>最近の振り返り</h3><% if (reflections.length === 0) { %><p class="small">まだ記録がありません。</p><% } else { reflections.forEach((item) => { %><div class="card small-card"><strong><%= item.reflection_date %></strong><div class="small">評価: <%= item.score %> / 5・<%= item.hours %>h</div><p><%= item.note %></p></div><% }); } %></div>
          </div>

          <div class="feature-view" data-view="reflection">
            <h2>振り返り</h2>
            <form method="post" action="/reflection" class="compact-form">
              <label>日付<input type="date" name="reflectionDate" required /></label>
              <label>自己評価<select name="score"><option value="1">1</option><option value="2">2</option><option value="3" selected>3</option><option value="4">4</option><option value="5">5</option></select></label>
              <label>描いた時間<input type="number" step="0.5" min="0" name="hours" value="1" required /></label>
              <label>メモ<textarea name="note" rows="3" required></textarea></label>
              <button type="submit">保存</button>
            </form>
          </div>

          <div class="feature-view" data-view="calendar">
            <h2><%= year %>年 <%= month + 1 %>月</h2>
            <div class="calendar-grid"><% ['日','月','火','水','木','金','土'].forEach((dow) => { %><div class="calendar-day calendar-heading"><strong><%= dow %></strong></div><% }); %><% for (let blank = 0; blank < monthData.firstDay.getDay(); blank += 1) { %><div class="calendar-day is-empty"></div><% } %><% monthData.days.forEach((day) => { const key = day.toISOString().slice(0, 10); %><div class="calendar-day"><div class="date"><%= day.getDate() %></div><% if (calendar[key]) { %><div class="small">記録あり</div><% } %></div><% }); %></div>
          </div>

          <div class="feature-view" data-view="illustrations">
            <h2>イラスト</h2>
            <form method="post" action="/illustrations" enctype="multipart/form-data" class="compact-form">
              <label>タイトル<input type="text" name="title" placeholder="今日の一枚" /></label>
              <label>画像<input type="file" name="image" accept="image/png,image/jpeg,image/webp" required /></label>
              <button type="submit">保存</button>
            </form>
            <div class="illustration-grid"><% illustrations.forEach((item) => { %><div class="card small-card"><strong><%= item.title %></strong><img class="uploaded" src="/uploads/<%= item.file_name %>" alt="<%= item.title %>" /></div><% }); %></div>
          </div>

          <div class="feature-view" data-view="settings">
            <h2>設定</h2>
            <form method="post" action="/character" class="compact-form">
              <label>名前<input type="text" name="name" value="<%= character?.name || '' %>" required /></label>
              <label>性格<input type="text" name="personality" value="<%= character?.personality || '' %>" required /></label>
              <label>口調<input type="text" name="style" value="<%= character?.style || '' %>" required /></label>
              <label>挨拶<textarea name="greeting" rows="3" required><%= character?.greeting || '' %></textarea></label>
              <button type="submit">設定を保存</button>
            </form>
            <form method="post" action="/reset" class="reset-form"><button type="submit" class="danger-button">全てリセット</button></form>
          </div>
        </section>

        <section class="chat-panel" data-chat-mode="comments">
          <div class="chat-comments" id="chat-comments"><% reflections.slice(0, 3).forEach((item) => { %><div class="chat-bubble"><%= item.reflection_date %> : <%= item.note %></div><% }); %><% if (reflections.length === 0) { %><div class="chat-bubble ai"><%= character?.greeting || 'こんにちは' %></div><% } %></div>
          <form id="chat-form" class="chat-form">
            <textarea id="message" name="message" rows="3" placeholder="今日の気持ちや練習について入力"></textarea>
            <button type="submit">送信</button>
          </form>
          <button type="button" id="chat-mode-toggle" class="chat-mode-toggle" aria-label="チャットの表示を切り替え">入力</button>
        </section>
      </section>

      <aside class="sidebar">
        <section class="sidebar-menu panel">
          <div class="menu-list">
            <button type="button" class="menu-button is-active" data-view-target="home" aria-label="ホーム">ホーム</button>
            <button type="button" class="menu-button" data-view-target="reflection" aria-label="振り返り">振り返り</button>
            <button type="button" class="menu-button" data-view-target="calendar" aria-label="カレンダー">カレンダー</button>
            <button type="button" class="menu-button" data-view-target="illustrations" aria-label="イラスト">イラスト</button>
            <button type="button" class="menu-button" data-view-target="settings" aria-label="設定">設定</button>
          </div>
        </section>

        <section class="sidebar-character panel">
          <% const normalCharacterImage = characterImages.find((image) => image.key === 'normal'); %>
          <img id="pal-image" class="character-image" src="<%= normalCharacterImage.src %>" alt="<%= character?.name || 'AIキャラクター' %>" />
          <div class="character-label"><%= character?.name || 'AIキャラクター' %></div>
        </section>
      </aside>
    </main>

    <script>window.palImages = <%- palImagesJson %>;</script>
    <script src="/app.js"></script>
  </body>
</html>
