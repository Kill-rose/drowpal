<!DOCTYPE html>
<html lang="ja">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Drowpal | 振り返り</title>
    <link rel="stylesheet" href="/style.css" />
    <script>(function () { var t = localStorage.getItem('drowpal-theme'); if (t) { document.documentElement.dataset.theme = t; } })();</script>
  </head>
  <body>
    <nav>
      <div class="nav-inner">
        <strong>Drowpal</strong>
        <div class="links">
          <a href="/">ホーム</a>
          <a href="/chat">チャット</a>
          <a href="/reflection">振り返り</a>
          <a href="/calendar">カレンダー</a>
          <a href="/character">パル</a>
          <a href="/illustrations">イラスト</a>
        </div>
      </div>
    </nav>

    <main>
      <section class="hero"><h1>イラストを振り返る</h1><p>画像ごとの評価や気づきを記録できます。</p></section>

      <div class="grid">
        <section class="panel">
          <h2>振り返り</h2>
          <form method="post" action="/reflection" id="reflection-form">
            <% if (editReflection) { %><input type="hidden" name="reflectionId" value="<%= editReflection.id %>" /><% } %>
            <label>イラスト<select name="illustrationId" required><option value="">選択してください</option><% illustrations.forEach((item) => { %><option value="<%= item.id %>" data-date="<%= item.illustration_date %>" <%= selectedIllustrationId === item.id ? 'selected' : '' %>><%= item.illustration_date %>・<%= item.title %></option><% }); %></select></label>
            <label>日付<input type="date" name="reflectionDate" value="<%= editReflection?.reflection_date || today %>" required /></label>
            <fieldset class="evaluation-section"><legend>総合評価</legend><% const overallScore = editReflection?.score || 3; %><input type="hidden" name="score" value="<%= overallScore %>" /><div class="score-picker" data-score-picker><% for (let score = 1; score <= 5; score += 1) { %><button type="button" class="<%= score <= overallScore ? 'is-selected' : '' %>" data-score="<%= score %>"><%= score <= overallScore ? '●' : '○' %></button><% } %></div></fieldset>
            <fieldset class="type-toggle-group"><legend>タイプ</legend><label class="type-toggle"><input type="checkbox" data-type="person" /> 人物</label><label class="type-toggle"><input type="checkbox" data-type="landscape" /> 風景</label></fieldset>
            <div id="evaluation-items"></div>
            <button type="button" class="secondary" id="add-evaluation">評価項目を追加</button>
            <input type="hidden" name="evaluationData" id="evaluation-data" />
            <label>所要時間（h）<input type="number" step="0.5" min="0" name="hours" value="<%= editReflection?.hours || 0 %>" /></label>
            <label>メモ<textarea name="note" rows="4" placeholder="今日の気持ちや工夫したこと"><%= editReflection?.note || '' %></textarea></label>
            <button type="submit"><%= editReflection ? '変更を保存' : '保存' %></button>
          </form>
        </section>

        <section class="panel">
          <h2>過去の記録</h2>
          <% if (reflections.length === 0) { %>
            <p class="small">まだ記録がありません。</p>
          <% } else { %>
            <% reflections.forEach((item) => { %>
              <details class="card"><summary><strong><%= item.reflection_date %>・<%= item.title || '未選択のイラスト' %></strong><span class="small"> 総合評価: <%= '●'.repeat(item.score) %><%= '○'.repeat(5 - item.score) %>・<%= item.hours %>h</span></summary><% if (item.file_name) { %><img class="uploaded" src="/uploads/<%= item.file_name %>" alt="<%= item.title %>" /><% } %><p><%= item.note %></p><% item.evaluations.forEach((evaluation) => { %><div class="small"><strong><%= evaluation.name %></strong> <%= '●'.repeat(evaluation.score) %><%= '○'.repeat(5 - evaluation.score) %> <%= evaluation.reason %></div><% }); %><a href="/reflection?edit=<%= item.id %>">編集</a></details>
            <% }) %>
          <% } %>
        </section>
      </div>
    </main>
    <script>window.reflectionDraft = <%- editReflectionJson %>;</script>
    <script src="/reflection.js"></script>
  </body>
</html>
